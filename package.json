{
  "name": "aloa-cms",
  "version": "1.0.0",
  "private": true,
  "description": "Advance Law of Attraction landing page with admin CMS",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "create-admin": "node scripts/create-admin.js",
