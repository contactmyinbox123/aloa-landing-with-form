# Copy to .env for local use (never commit .env). On Hostinger, enter these in hPanel → Environment variables.

# --- Server ---
NODE_ENV=production
# Hostinger sets PORT automatically – do not add it there. Locally the default is 3000.
# PORT=3000
# HOST=0.0.0.0
PUBLIC_URL=https://www.yourdomain.com
TRUST_PROXY=1
SESSION_DAYS=7

# --- Supabase PostgreSQL ---
# Supabase → Connect → "Session pooler" connection string (works over IPv4). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
# SSL is on automatically for remote databases. Optional: verify the certificate as well.
# DATABASE_SSL=verify
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
PG_POOL_MAX=5

# --- Supabase Storage (images) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Server-side only – never put it in front-end code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=aloa-media
MAX_UPLOAD_MB=5

# --- Email (password resets + new-enquiry notifications) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=
MAIL_FROM="ALOA Website <no-reply@yourdomain.com>"
